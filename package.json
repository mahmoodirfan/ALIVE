{
  "name": "alive-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && pnpm -r test",
    "build": "pnpm -r build",
    "demo": "pnpm --filter @alive-demo/store dev",
    "demo:build": "pnpm --filter @alive-demo/store build",
    "build:packages": "pnpm --filter \"./packages/**\" -r build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23"
  }
}
